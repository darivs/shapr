#!/usr/bin/env node
// The shot loop, run from the demo space (bin/demo up): one `herdr-app shot` per state.
// Usage:
//   bin/shots <prefix> [states...] [--light|--dark] [--zoom <z>] [--density <d>] [--corners <c>]
//             [--motion <m>] [--contrast <c>] [--seed <rrggbb>]
//       writes <prefix>-<state>.png for each state (default: every one in STATES), closing each
//       overlay before the next. Light or dark and zoom go into settings.json, the theme settings
//       through shapr-workspace-chrome's commands; bin/demo down puts both back.
//   bin/shots --restore-theme <file>   sets the theme settings saved in <file> (JSON) again
//   bin/shots [--crop sidebar|work] [--mask] <in.png> [<out.png>]
//       cuts an image to one area, and covers every sidebar row outside the demo space (bin/demo
//       puts it first in the spaces list and pins its agents) with a solid box, so the image can
//       be committed. Writes over <in.png> when no <out.png>.
import { execFileSync } from "node:child_process";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { deflateSync, inflateSync } from "node:zlib";

const home = process.env.HERDR_APP_HOME ?? join(homedir(), ".config", "herdr-app");

// PNG ------------------------------------------------------------------------------------------

const CRC = new Int32Array(256).map((_, n) => {
  let c = n;
  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c;
});
const crc32 = (buf) => {
  let c = -1;
  for (const b of buf) c = CRC[(c ^ b) & 0xff] ^ (c >>> 8);
  return (c ^ -1) >>> 0;
};
const SIGNATURE = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);

/** An 8-bit RGB or RGBA, non-interlaced PNG as { width, height, data } (RGBA, 4 bytes a pixel). */
export function decodePng(buf) {
  if (!buf.subarray(0, 8).equals(SIGNATURE)) throw new Error("not a PNG");
  let at = 8, width, height, colorType, idat = [];
  while (at < buf.length) {
    const len = buf.readUInt32BE(at), kind = buf.toString("latin1", at + 4, at + 8), body = buf.subarray(at + 8, at + 8 + len);
    if (kind === "IHDR") {
      width = body.readUInt32BE(0); height = body.readUInt32BE(4); colorType = body[9];
      if (body[8] !== 8 || ![2, 6].includes(colorType) || body[12] !== 0) throw new Error("only 8-bit RGB or RGBA, non-interlaced");
    } else if (kind === "IDAT") idat.push(body);
    else if (kind === "IEND") break;
    at += 12 + len;
  }
  const bpp = colorType === 6 ? 4 : 3, stride = width * bpp;
  const raw = inflateSync(Buffer.concat(idat)), px = Buffer.alloc(stride * height);
  for (let y = 0; y < height; y++) {
    const f = raw[y * (stride + 1)], src = y * (stride + 1) + 1, row = y * stride, up = row - stride;
    for (let x = 0; x < stride; x++) {
      const a = x >= bpp ? px[row + x - bpp] : 0, b = y ? px[up + x] : 0, c = y && x >= bpp ? px[up + x - bpp] : 0;
      let p = raw[src + x];
      if (f === 1) p += a;
      else if (f === 2) p += b;
      else if (f === 3) p += (a + b) >> 1;
      else if (f === 4) {
        const q = a + b - c, pa = Math.abs(q - a), pb = Math.abs(q - b), pc = Math.abs(q - c);
        p += pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
      }
      px[row + x] = p;
    }
  }
  if (bpp === 4) return { width, height, data: px };
  const data = Buffer.alloc(width * height * 4);
  for (let i = 0, j = 0; i < px.length; i += 3, j += 4) { data[j] = px[i]; data[j + 1] = px[i + 1]; data[j + 2] = px[i + 2]; data[j + 3] = 255; }
  return { width, height, data };
}

/** { width, height, data } (RGBA) as a PNG. */
export function encodePng({ width, height, data }) {
  const chunk = (kind, body) => {
    const head = Buffer.alloc(8);
    head.writeUInt32BE(body.length, 0); head.write(kind, 4, "latin1");
    const tail = Buffer.alloc(4);
    tail.writeUInt32BE(crc32(Buffer.concat([head.subarray(4), body])), 0);
    return Buffer.concat([head, body, tail]);
  };
  const ihdr = Buffer.alloc(13);
  ihdr.writeUInt32BE(width, 0); ihdr.writeUInt32BE(height, 4); ihdr[8] = 8; ihdr[9] = 6;
  const raw = Buffer.alloc((width * 4 + 1) * height);
  for (let y = 0; y < height; y++) data.copy(raw, y * (width * 4 + 1) + 1, y * width * 4, (y + 1) * width * 4);
  return Buffer.concat([SIGNATURE, chunk("IHDR", ihdr), chunk("IDAT", deflateSync(raw)), chunk("IEND", Buffer.alloc(0))]);
}

/** The part of an image inside box [x, y, w, h] (clipped to the image). */
export function crop(img, [x, y, w, h]) {
  x = Math.max(0, Math.round(x)); y = Math.max(0, Math.round(y));
  w = Math.min(img.width - x, Math.round(w)); h = Math.min(img.height - y, Math.round(h));
  const data = Buffer.alloc(w * h * 4);
  for (let r = 0; r < h; r++) img.data.copy(data, r * w * 4, ((y + r) * img.width + x) * 4, ((y + r) * img.width + x + w) * 4);
  return { width: w, height: h, data };
}

/** The image with each box [x, y, w, h] filled with one solid color [r, g, b]. */
export function fill(img, boxes, [r, g, b]) {
  const data = Buffer.from(img.data);
  for (const [bx, by, bw, bh] of boxes)
    for (let y = Math.max(0, by); y < Math.min(img.height, by + bh); y++)
      for (let x = Math.max(0, bx); x < Math.min(img.width, bx + bw); x++) data.set([r, g, b, 255], (y * img.width + x) * 4);
  return { ...img, data };
}

// Where things are -----------------------------------------------------------------------------

const at = (img, x, y) => img.data.readUInt32BE((y * img.width + x) * 4);

// The sidebar's edge: the first column, left of the middle, that one color fills top to bottom
// (its border line), where the column before it is another color.
function sidebarEdge(img) {
  const mid = img.height >> 1;
  for (let x = 1; x < img.width * 0.6; x++) {
    const c = at(img, x, mid);
    if (c === at(img, x - 1, mid)) continue;
    let same = 0;
    for (let y = 0; y < img.height; y++) if (at(img, x, y) === c) same++;
    if (same >= img.height * 0.95) return { x, color: c };
  }
  throw new Error("no sidebar edge in the shot");
}

// The rows the sidebar's line color crosses from side to side (a divider, 1 or more px): their tops.
function dividers(img, edge) {
  const out = [];
  for (let y = 0, prev = false; y < img.height; y++) {
    let same = 0;
    for (let x = 0; x < edge.x; x++) if (at(img, x, y) === edge.color) same++;
    const line = same >= edge.x * 0.9;
    if (line && !prev) out.push(y);
    prev = line;
  }
  return out;
}

// The sidebar's background: the color most of its leftmost columns show (rows never start there).
function background(img, [x, y, , h]) {
  const count = new Map();
  for (let r = y; r < y + h; r++) count.set(at(img, x + 2, r), (count.get(at(img, x + 2, r)) ?? 0) + 1);
  const c = [...count].sort((a, b) => b[1] - a[1])[0]?.[0] ?? 0;
  return [c >>> 24, (c >>> 16) & 255, (c >>> 8) & 255];
}

const DENSITY = { compact: -4, standard: 0, comfortable: 4 };

/**
 * The window's areas in image pixels: sidebar and work from the edge the shot shows, and the
 * boxes --mask covers. Under the brand bar (a control and 8 above and below), the demo space keeps
 * the "Spaces" heading and its one row; under the agents list's border it keeps the heading, the
 * "Pinned" header and one row an agent (bin/demo pins them). Everything else down to the next
 * divider is covered. u is image px a window px at zoom 1 (scale x zoom).
 */
export function areas(img, { u = 2, density = "standard", agents = 4, layout = null } = {}) {
  if (layout) return fromLayout(img, { u, density, agents, layout });
  const edge = sidebarEdge(img), off = DENSITY[density] ?? 0, row = (40 + off) * u;
  const top = (32 + off + 16) * u, lines = dividers(img, edge).filter((y) => y > top);
  const foot = lines.at(-1) ?? img.height, list = lines.length > 1 ? lines[0] : null;
  const box = (from, to) => [0, from, edge.x, Math.max(0, to - from)];
  const mask = [box(Math.round(top + 36 * u + row), list ?? foot)];
  if (list !== null) mask.push(box(Math.round(list + (1 + 36 + 40) * u + agents * row), foot));
  return { sidebar: [0, 0, edge.x, img.height], work: [edge.x, 0, img.width - edge.x, img.height], mask };
}

const node = (n, id) => (n?.id === id ? n : (n?.children ?? []).map((c) => node(c, id)).find(Boolean));

/**
 * areas() when no line marks the sidebar (D10: space, not lines): the sidebar's width and the
 * spaces and agents lists' weights from the layout, the brand bar (a control and 8 above and below)
 * and the footer (three rows and 8 above and below) from the density. The demo space is active,
 * so its row has two lines; the agents list keeps its heading (8 above), the "Pinned" header
 * (4 above) and one row an agent.
 */
function fromLayout(img, { u, density, agents, layout }) {
  const off = DENSITY[density] ?? 0, row = (40 + off) * u;
  const width = Math.round((node(layout, "sidebar")?.size?.px ?? 268) * u);
  const top = (32 + off + 16) * u, foot = img.height - (16 + 3 * (40 + off)) * u;
  const weight = (id) => node(layout, id)?.size?.weight ?? 1;
  const list = Math.round(top + ((foot - top) * weight("spaces")) / (weight("spaces") + weight("agents")));
  const box = (from, to) => [0, Math.round(from), width, Math.max(0, Math.round(to - from))];
  const mask = [box(top + 36 * u + (56 + off) * u, list), box(list + (8 + 36 + 40) * u + agents * row, foot)];
  return { sidebar: [0, 0, width, img.height], work: [width, 0, img.width - width, img.height], mask };
}

const readJson = (p, d) => { try { return JSON.parse(readFileSync(p, "utf8")); } catch { return d; } };

function liveAreas(img) {
  const win = readJson(join(home, "window.json"), {});
  const scale = win.bounds ? img.width / win.bounds[2] : 2;
  const zoom = readJson(join(home, "settings.json"), {}).zoom ?? 1;
  const density = readJson(join(home, "shared.json"), {})["shapr.settings"]?.density;
  // The layout as Herdr keeps it; without one, the lines the shot shows.
  const layout = readJson(join(home, "layouts", "shapr-material.json"), null);
  return areas(img, { u: scale * zoom, density, layout: layout?.root ?? layout });
}

/** --mask, then --crop, on one image file. */
function edit(file, out, { cropTo, mask }) {
  let img = decodePng(readFileSync(file));
  const a = liveAreas(img);
  if (mask) img = fill(img, a.mask, background(img, a.sidebar));
  if (cropTo) img = crop(img, a[cropTo]);
  writeFileSync(out, encodePng(img));
}

// The app ---------------------------------------------------------------------------------------

const app = (...args) => execFileSync("herdr-app", args, { encoding: "utf8" });
// A command; one with nothing to act on (overlay.close with no overlay open) is no failure.
const run = (name, args) => {
  try { app("do", name, ...(args ? [JSON.stringify(args)] : [])); } catch { /* nothing to act on */ }
};
const sleep = (s) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, s * 1000);

// Every state, as what opens it from a window with no overlay open, and what it leaves open
// beyond an overlay: the gallery is a window mod.open toggles, Files and Changes the panel.
const chrome = (c) => () => run(`shapr-workspace-chrome.${c}`);
const modOpen = (name) => () => run("mod.open", { name });
const panel = (child) => () => { run("layout.select", { stack: "panel-body", child }); run("layout.show", { id: "panel" }); };
const hidePanel = () => run("layout.hide", { id: "panel" });
export const STATES = {
  base: [() => {}],
  "new-menu": [chrome("new-menu")],
  "tab-menu": [chrome("tab-menu")],
  "space-menu": [chrome("space-menu")],
  "terminal-menu": [chrome("terminal-menu")],
  rename: [chrome("rename-tab")],
  theme: [chrome("theme")],
  picker: [modOpen("shapr-picker")],
  help: [modOpen("shapr-help")],
  "machine-add": [modOpen("shapr-machine-add")],
  gallery: [modOpen("shapr-gallery"), modOpen("shapr-gallery")],
  files: [panel("files"), hidePanel],
  changes: [panel("changes"), hidePanel],
};

const close = () => { run("overlay.close"); run("overlay.close"); sleep(0.4); };

const PREFS = { density: ["compact", "standard", "comfortable"], corners: ["standard", "round"], motion: ["expressive", "calm", "reduced"], contrast: ["standard", "medium", "high"] };

/** Sets theme settings ({ density, corners, motion, contrast, seed }) by shapr-workspace-chrome's commands. */
function setTheme(t, { reset = false } = {}) {
  if (reset) run("shapr-workspace-chrome.reset-theme");
  for (const [k, values] of Object.entries(PREFS)) if (values.includes(t[k])) run(`shapr-workspace-chrome.set-${k}-${t[k]}`);
  if (/^#?[0-9a-fA-F]{6}$/.test(t.seed ?? "")) run(`shapr-workspace-chrome.seed-${t.seed.replace("#", "")}`);
}

function shoot(prefix, states, opts) {
  for (const name of states) if (!STATES[name]) throw new Error(`no state ${name} (${Object.keys(STATES).join(", ")})`);
  const path = join(home, "settings.json"), s = readJson(path, {});
  if (opts.appearance) s.appearance = opts.appearance;
  if (opts.zoom) s.zoom = Number(opts.zoom);
  if (opts.appearance || opts.zoom) { writeFileSync(path, JSON.stringify(s, null, 2) + "\n"); sleep(1); }
  setTheme(opts);
  hidePanel();
  for (const name of states) {
    const [open, after] = STATES[name];
    close();
    open();
    sleep(1.2);
    console.log(app("shot", `${prefix}-${name}.png`).trim());
    after?.();
  }
  close();
}

function main(argv) {
  const opts = {}, rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--crop") opts.cropTo = argv[++i];
    else if (a === "--mask") opts.mask = true;
    else if (a === "--light" || a === "--dark") opts.appearance = a.slice(2);
    else if (a === "--restore-theme") opts.restore = argv[++i];
    else if (["--zoom", "--density", "--corners", "--motion", "--contrast", "--seed"].includes(a)) opts[a.slice(2)] = argv[++i];
    else rest.push(a);
  }
  if (opts.restore) return setTheme(readJson(opts.restore, null) ?? {}, { reset: true });
  if (opts.cropTo !== undefined && !["sidebar", "work"].includes(opts.cropTo)) throw new Error("--crop sidebar|work");
  if (opts.mask || opts.cropTo) {
    const [file, out = file] = rest;
    if (!file || !existsSync(file)) throw new Error("usage: bin/shots [--crop sidebar|work] [--mask] <in.png> [<out.png>]");
    return edit(file, out, opts);
  }
  const [prefix, ...states] = rest;
  if (!prefix) throw new Error("usage: bin/shots <prefix> [states...] [--light|--dark] [--zoom z] [--density d] [--corners c] [--motion m] [--contrast c] [--seed rrggbb]");
  shoot(prefix, states.length ? states : Object.keys(STATES), opts);
}

if (import.meta.url === `file://${process.argv[1]}`) {
  try { main(process.argv.slice(2)); } catch (e) { console.error(`shots: ${e.message}`); process.exit(1); }
}
