#!/bin/sh
# Every check the repo has: herdr-app check per mod (needs Herdr), the kit copies, the tests,
# a syntax check of every .js file, and the privacy check. Exits nonzero on the first failure.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
fail=0
if command -v herdr-app >/dev/null; then
  for d in shapr/mods/shapr-*/; do
    out=$(herdr-app check "$d" 2>&1); code=$?
    case "$out" in *"check passed"*) [ $code -eq 0 ] || fail=1 ;; *) echo "$out"; fail=1 ;; esac
  done
  [ $fail -eq 0 ] && echo "herdr-app check: OK"
else
  echo "herdr-app check: skipped (no herdr-app)"
fi
bin/sync-kit --check || fail=1
log=$(mktemp)
node --import ./test/loader.js --test test/ >"$log" 2>&1 && echo "tests: OK" || { cat "$log"; fail=1; }
rm -f /tmp/shapr-tests.$$
for f in $(git ls-files --cached --others --exclude-standard '*.js') bin/clone-mods bin/sync-kit bin/privacy-check bin/drift; do
  node --input-type=module --check < "$f" || { echo "syntax: $f"; fail=1; }
done
[ $fail -eq 0 ] && echo "node --check: OK"
bin/privacy-check || fail=1
exit $fail
