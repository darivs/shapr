#!/bin/sh
# Rebuilds shapr-workspace-chrome/theme/mcu.js: the parts of material-color-utilities the theme
# generator uses, bundled into one ES module (a mod imports only from its own folder).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
npm init -y >/dev/null
npm i -s @material/material-color-utilities@0.3.0 esbuild@0.24.0 >/dev/null
echo 'export { Hct, SchemeTonalSpot, MaterialDynamicColors, argbFromHex, hexFromArgb, Contrast, TonalPalette } from "@material/material-color-utilities";' > entry.js
./node_modules/.bin/esbuild entry.js --bundle --format=esm --minify-whitespace --legal-comments=none --outfile=mcu.js --log-level=warning
out="$root/shapr/mods/shapr-workspace-chrome/theme/mcu.js"
{
  echo "// material-color-utilities 0.3.0 (Hct, SchemeTonalSpot, MaterialDynamicColors, TonalPalette, hex helpers),"
  echo "// bundled into one module. Copyright Google LLC, Apache License 2.0: see LICENSES/Apache-2.0.txt."
  echo "// Generated by bin/bundle-mcu; do not edit."
  cat mcu.js
} > "$out"
echo "wrote $out"
